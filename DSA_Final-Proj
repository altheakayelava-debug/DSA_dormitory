#include <iostream>
#include <vector>
#include <fstream>
#include <sstream>
#include <map>
#include <iomanip>

using namespace std;

// ── STRUCTURES ─────────────────────
struct Tenant {
    string name;
    int age;
    string room;
    string payment;
};

struct Room {
    int capacity = 4;
    vector<string> occupants;
};

// ── GLOBAL DATA ─────────────────────
vector<Tenant> tenants;
map<string, Room> rooms;

// ── INITIALIZE ROOMS ─────────────────────
void initializeRooms() {

    for (int i = 1; i <= 10; i++) {
        rooms["Room " + to_string(i)] = Room();
    }
}

// ── SYNC ROOMS ─────────────────────
void syncRooms() {

    for (auto &r : rooms) {
        r.second.occupants.clear();
    }

    for (auto &t : tenants) {
        rooms[t.room].occupants.push_back(t.name);
    }
}

// ── SAVE DATA ─────────────────────
void saveData() {

    ofstream file("data.txt");

    for (auto &t : tenants) {

        file << t.name << ","
             << t.age << ","
             << t.room << ","
             << t.payment << endl;
    }

    file.close();
}

// ── LOAD DATA ─────────────────────
void loadData() {

    ifstream file("data.txt");
    string line;

    while (getline(file, line)) {

        stringstream ss(line);

        Tenant t;

        getline(ss, t.name, ',');

        ss >> t.age;
        ss.ignore();

        getline(ss, t.room, ',');
        getline(ss, t.payment);

        tenants.push_back(t);
    }

    file.close();

    syncRooms();
}

// ── VIEW TENANTS ─────────────────────
void viewTenants() {

    if (tenants.empty()) {
        cout << "\nNo tenants found.\n";
        return;
    }

    cout << "\n=================================================================\n";
    cout << "                         TENANTS LIST                            \n";
    cout << "=================================================================\n";

    // HEADER
    cout << left
         << setw(5)  << "No."
         << setw(30) << "Name"
         << setw(8)  << "Age"
         << setw(12) << "Room"
         << setw(12) << "Payment"
         << endl;

    cout << "-----------------------------------------------------------------\n";

    // DISPLAY DATA
    for (int i = 0; i < tenants.size(); i++) {

        cout << left
             << setw(5)  << i + 1
             << setw(30) << tenants[i].name
             << setw(8)  << tenants[i].age
             << setw(12) << tenants[i].room
             << setw(12) << tenants[i].payment
             << endl;
    }
}

// ── ADD TENANT ─────────────────────
void addTenant() {

    Tenant t;

    cout << "\n----------------------\n";
    cout << "      ADD TENANT      \n";
    cout << "----------------------\n";

    cin.ignore();

    cout << "Enter Name: ";
    getline(cin, t.name);

    cout << "Enter Age: ";
    cin >> t.age;

    cin.ignore();

    cout << "Enter Room (Room 1 - Room 10): ";
    getline(cin, t.room);

    syncRooms();

    // CHECK ROOM CAPACITY
    if (rooms[t.room].occupants.size() >= rooms[t.room].capacity) {

        cout << "Room FULL!\n";
        return;
    }

    cout << "Payment (Paid/Unpaid): ";
    getline(cin, t.payment);

    tenants.push_back(t);

    saveData();

    cout << "Tenant added successfully!\n";
}

// ── UPDATE TENANT ─────────────────────
void updateTenant() {

    viewTenants();

    int choice;

    cout << "\nSelect tenant number to update: ";
    cin >> choice;

    if (choice < 1 || choice > tenants.size()) {

        cout << "Invalid choice!\n";
        return;
    }

    Tenant &t = tenants[choice - 1];

    cin.ignore();

    cout << "Name: ";
    getline(cin, t.name);

    cout << "Age: ";
    cin >> t.age;

    cin.ignore();

    cout << "Room: ";
    getline(cin, t.room);

    cout << "Payment: ";
    getline(cin, t.payment);

    saveData();

    cout << "Updated successfully!\n";
}

// ── DELETE TENANT ─────────────────────
void deleteTenant() {

    viewTenants();

    int choice;

    cout << "\nSelect tenant number to delete: ";
    cin >> choice;

    if (choice < 1 || choice > tenants.size()) {

        cout << "Invalid choice!\n";
        return;
    }

    tenants.erase(tenants.begin() + choice - 1);

    saveData();

    cout << "Deleted successfully!\n";
}

// ── ROOM STATUS ─────────────────────
void viewRooms() {

    syncRooms();

    cout << "\n===================================\n";
    cout << "            ROOM STATUS            \n";
    cout << "===================================\n";

    cout << left
         << setw(15) << "Room"
         << setw(12) << "Occupied"
         << setw(12) << "Capacity"
         << endl;

    cout << "-----------------------------------\n";

    for (int i = 1; i <= 10; i++) {

        string roomName = "Room " + to_string(i);

        cout << left
             << setw(15) << roomName
             << setw(12) << rooms[roomName].occupants.size()
             << setw(12) << rooms[roomName].capacity
             << endl;
    }
}

// ── SUMMARY ─────────────────────
void summary() {

    syncRooms();

    int totalCapacity = 0;
    int occupied = 0;
    int paid = 0;

    for (auto &r : rooms) {

        totalCapacity += r.second.capacity;
        occupied += r.second.occupants.size();
    }

    for (auto &t : tenants) {

        if (t.payment == "Paid") {
            paid++;
        }
    }

    cout << "\n========================\n";
    cout << "        SUMMARY         \n";
    cout << "========================\n";

    cout << "Total Capacity : " << totalCapacity << endl;
    cout << "Occupied       : " << occupied << endl;
    cout << "Available      : " << totalCapacity - occupied << endl;
    cout << "Total Tenants  : " << tenants.size() << endl;
    cout << "Paid           : " << paid << endl;
    cout << "Unpaid         : " << tenants.size() - paid << endl;
}

// ── MAIN MENU ─────────────────────
int main() {

    initializeRooms();

    loadData();

    string again = "yes";

    while (again == "yes") {

        int choice;

        cout << "\n====================================\n";
        cout << "      DORM MANAGEMENT SYSTEM        \n";
        cout << "====================================\n";

        cout << "1. Add Tenant\n";
        cout << "2. View Tenants\n";
        cout << "3. Update Tenant\n";
        cout << "4. Delete Tenant\n";
        cout << "5. Room Status\n";
        cout << "6. Summary\n";

        cout << "\nChoose: ";
        cin >> choice;

        switch (choice) {

            case 1:
                addTenant();
                break;

            case 2:
                viewTenants();
                break;

            case 3:
                updateTenant();
                break;

            case 4:
                deleteTenant();
                break;

            case 5:
                viewRooms();
                break;

            case 6:
                summary();
                break;

            default:
                cout << "Invalid choice!\n";
        }

        cout << "\nDo you want to continue? (yes/no): ";
        cin >> again;
    }

    cout << "\nProgram Ended.\n";

    return 0;
}
