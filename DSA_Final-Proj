#include <iostream>
#include <vector>
#include <fstream>
#include <sstream>
#include <map>   
using namespace std;

// ── STRUCTURES ─────────────────────
struct Tenant {
    string name;
    int age;
    string room;
    string payment;
};

struct Room {
    int capacity = 4;
    vector<string> occupants;
};

// ── GLOBAL DATA ─────────────────────
vector<Tenant> tenants;
map<string, Room> rooms;

// ── INITIALIZE ROOMS ─────────────────────
void initializeRooms() {
    for (int i = 1; i <= 10; i++) {
        rooms["Room " + to_string(i)] = Room();
    }
}

// ── SYNC ROOMS ─────────────────────
void syncRooms() {
    for (auto &r : rooms) {
        r.second.occupants.clear();
    }

    for (auto &t : tenants) {
        rooms[t.room].occupants.push_back(t.name);
    }
}

// ── SAVE DATA ─────────────────────
void saveData() {
    ofstream file("data.txt");

    for (auto &t : tenants) {
        file << t.name << "," << t.age << "," << t.room << "," << t.payment << endl;
    }

    file.close();
}

// ── LOAD DATA ─────────────────────
void loadData() {
    ifstream file("data.txt");
    string line;

    while (getline(file, line)) {
        stringstream ss(line);
        Tenant t;

        getline(ss, t.name, ',');
        ss >> t.age;
        ss.ignore();
        getline(ss, t.room, ',');
        getline(ss, t.payment);

        tenants.push_back(t);
    }

    file.close();
    syncRooms();
}

// ── DISPLAY TENANTS ─────────────────────
void viewTenants() {
    cout << "\n-------------\n";
    cout << "   TENANT LIST   ";
    cout << "\n-------------\n";
    for (int i = 0; i < tenants.size(); i++) {
        cout << i + 1 << ". "
             << tenants[i].name << " | Age: " << tenants[i].age
             << " | " << tenants[i].room
             << " | " << tenants[i].payment << endl;
    }
}

// ── ADD TENANT ─────────────────────
void addTenant() {
    Tenant t;
    
    cout << "\n-----------------\n";
    cout << "    ADDING TENANT    ";
    cout << "\n-----------------\n";
    cout << "Enter name: ";
    cin.ignore();
    getline(cin, t.name);

    cout << "Enter age: ";
    cin >> t.age;

    cout << "Enter room (Room 1 - Room 10): ";
    cin.ignore();
    getline(cin, t.room);

    syncRooms();

    if (rooms[t.room].occupants.size() >= rooms[t.room].capacity) {
        cout << "Room FULL!\n";
        return;
    }

    cout << "Payment (Paid/Unpaid): ";
    getline(cin, t.payment);

    tenants.push_back(t);

    saveData();
    cout << "Tenant added successfully!\n";
}

// ── UPDATE TENANT ─────────────────────
void updateTenant() {
    viewTenants();
    int choice;
    
    cout << "\n------------------\n";
    cout << "    UPDATING TENANT   ";
    cout << "\n------------------\n";
    cout << "Select tenant number to update: ";
    cin >> choice;

    if (choice < 1 || choice > tenants.size()) return;

    Tenant &t = tenants[choice - 1];

    cout << "Name: ";
    cin.ignore();
    getline(cin, t.name);

    cout << "Age: ";
    cin >> t.age;

    cout << "Room: ";
    cin.ignore();
    getline(cin, t.room);

    cout << "Payment: ";
    getline(cin, t.payment);

    saveData();
    cout << "Updated successfully!\n";
}

// ── DELETE TENANT ─────────────────────
void deleteTenant() {
    viewTenants();
    int choice;
    
    cout << "\n----------------\n";
    cout << "    DELETE TENANT   ";
    cout << "\n----------------\n";
    cout << "Select tenant number to delete: ";
    cin >> choice;

    if (choice < 1 || choice > tenants.size()) return;

    tenants.erase(tenants.begin() + choice - 1);

    saveData();
    cout << "Deleted successfully!\n";
}

// ── ROOM STATUS ─────────────────────
void viewRooms() {
    syncRooms();
    
    cout << "\n-------------\n";
    cout << "   ROOM STATUS   ";
    cout << "\n-------------\n";
    for (auto &r : rooms) {
        cout << r.first << " -> "
             << r.second.occupants.size()
             << "/" << r.second.capacity << " occupied\n";
    }
}

// ── SUMMARY ─────────────────────
void summary() {
    syncRooms();

    int totalCapacity = 0, occupied = 0, paid = 0;

    for (auto &r : rooms) {
        totalCapacity += r.second.capacity;
        occupied += r.second.occupants.size();
    }

    for (auto &t : tenants) {
        if (t.payment == "Paid") paid++;
    }

    cout << "\n-------------\n";
    cout << "     SUMMARY    ";
    cout << "\n-------------\n";
    cout << "Total Capacity: " << totalCapacity << endl;
    cout << "Occupied: " << occupied << endl;
    cout << "Available: " << totalCapacity - occupied << endl;
    cout << "Total Tenants: " << tenants.size() << endl;
    cout << "Paid: " << paid << endl;
    cout << "Unpaid: " << tenants.size() - paid << endl;
}

// ── MAIN MENU ─────────────────────
int main() {
    initializeRooms();
    loadData();

    string again = "yes";

    while (again == "yes") {
        int choice;
        
        cout << "\n==================================\n";
        cout << "       DORM MANAGEMENT SYSTEM         ";
        cout << "\n==================================\n";
        cout << "1. Add Tenant\n";
        cout << "2. View Tenants\n";
        cout << "3. Update Tenant\n";
        cout << "4. Delete Tenant\n";
        cout << "5. Room Status\n";
        cout << "6. Summary\n\n";
        cout << "Choose: ";
        cin >> choice;

        switch (choice) {
            case 1: addTenant(); break;
            case 2: viewTenants(); break;
            case 3: updateTenant(); break;
            case 4: deleteTenant(); break;
            case 5: viewRooms(); break;
            case 6: summary(); break;
        }

        cout << "\nDo you want to continue? (yes/no): ";
        cin >> again;
    }

    cout << "Program Ended.\n";
    return 0;
}
